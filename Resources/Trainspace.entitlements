<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Sparkle's installer, from a sandboxed app (sparkle-project.org/documentation/sandboxing). -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>com.grantkovich.trainspace-spks</string>
		<string>com.grantkovich.trainspace-spki</string>
	</array>
	<!-- Without a paid Developer ID there's no Team ID, so library validation would refuse to
	     load Sparkle.framework. It's signed with the same certificate as the app. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
